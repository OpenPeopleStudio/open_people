{
  "name": "open_people",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "doctor": "bash scripts/doctor.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run --dir __tests__/unit",
    "test:integration": "vitest run --dir __tests__/integration",
    "test:isolation": "vitest run --dir __tests__/isolation",
    "test:e2e": "playwright test",
    "test:tenant": "vitest run --testPathPattern=tenant",
    "test:admin": "vitest run --testPathPattern=admin",
    "test:vault": "vitest run --testPathPattern=vault",
    "generate-assets": "node scripts/generate-assets.js",
    "generate:openapi": "node scripts/generate-openapi.js",
    "generate:sdk:ts": "npm run generate:openapi && npx openapi-typescript docs/api/openapi.json -o sdk/typescript/index.d.ts",
    "generate:sdk": "npm run generate:sdk:ts",
    "supabase:health": "node scripts/supabase-health.js",
    "queue:worker": "node scripts/start-worker.js",
    "db:migrate": "supabase db push",
    "db:seed": "node scripts/seed-mars-tenant.js",
    "check:api-docs": "node scripts/check-api-docs.js"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.972.0",
    "@aws-sdk/client-s3": "^3.971.0",
    "@aws-sdk/s3-request-presigner": "^3.971.0",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@microsoft/microsoft-graph-types": "^2.43.1",
    "@sentry/nextjs": "^8.55.0",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.90.1",
    "@vercel/og": "^0.8.6",
    "bullmq": "^5.3.0",
    "googleapis": "^170.1.0",
    "imap-simple": "^5.1.0",
    "imapflow": "^1.2.6",
    "lucide-react": "^0.468.0",
    "mailparser": "^3.9.1",
    "next": "16.1.3",
    "node-pop3": "^0.11.0",
    "nodemailer": "^7.0.12",
    "openai": "^4.77.4",
    "pdfjs-dist": "^5.4.530",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "resend": "^6.7.0",
    "sharp": "^0.34.5",
    "tiktoken": "^1.0.22",
    "twilio": "^5.11.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.0.0",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^2.1.0",
    "@vitest/ui": "^2.1.0",
    "dotenv": "^17.2.3",
    "eslint": "^9",
    "eslint-config-next": "16.1.3",
    "jsdom": "^25.0.0",
    "openapi-typescript": "^7.10.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^2.1.0"
  }
}
